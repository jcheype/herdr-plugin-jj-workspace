# Copy to the plugin config dir as `.env`:
#   cp .env.example "$(herdr plugin config-dir nathanflurry.jj-workspace)/.env"
#
# Where new jj workspaces are checked out. If unset, defaults to
# ~/.herdr/workspaces/<repo>/<workspace-slug>.
# JJ_WORKSPACE_ROOT="$HOME/.herdr/workspaces"
#
# Revision new workspaces are based on (after `jj git fetch`). Defaults to
# trunk(), jj's builtin alias for main@origin / master@origin.
# JJ_BASE_REV="main@origin"
